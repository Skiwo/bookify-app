.row
  .col-lg-8
    .d-flex.align-items-start.mb-4
      = shop_avatar(@shop, size: 64)
      .me-auto.ms-3
        %h2.fw-bold.mb-1= @shop.name
        - if @shop.city.present?
          %p.text-muted.mb-2
            %i.bi.bi-geo-alt.me-1
            = @shop.city
        - if @shop.skills.any?
          - @shop.skills.ordered.each do |skill|
            = link_to skill.name, skill_page_path(skill: skill.slug), class: "badge bg-light text-dark border me-1 text-decoration-none"

    - if @shop.description.present?
      .card.border-0.shadow-sm.mb-4
        .card-body
          %p.mb-0= @shop.description

    - if @members.any?
      %h5.fw-bold.mb-3= t("shops.show.team_heading")
      .row.row-cols-1.row-cols-md-2.g-3.mb-4
        - @members.each do |member|
          .col
            .card.border-0.shadow-sm
              .card-body.d-flex.align-items-center
                = user_avatar(member.enrollment&.freelancer || member.name, size: 44)
                .ms-3
                  %p.fw-medium.mb-0= member.name

  .col-lg-4
    - if @shop.paused?
      .card.border-0.shadow-sm.sticky-top{style: "top: 1rem"}
        .card-body.text-center.py-4
          %i.bi.bi-pause-circle.display-4.text-warning.mb-3
          %h6.fw-bold= t("shops.show.paused_heading")
          %p.text-muted.small.mb-0= t("shops.show.paused_body")

    - elsif @shop.closed?
      .card.border-0.shadow-sm.sticky-top{style: "top: 1rem"}
        .card-body.text-center.py-4
          %i.bi.bi-x-circle.display-4.text-secondary.mb-3
          %h6.fw-bold= t("shops.show.closed_heading")
          %p.text-muted.small.mb-0= t("shops.show.closed_body")

    - else
      .card.border-0.shadow-sm.sticky-top{style: "top: 1rem"}
        .card-header.fw-bold.bg-white= t("shops.show.request_heading")
        .card-body
          - if current_user&.client?
            = form_with url: shop_requests_path(@shop.slug), method: :post, local: true do |f|
              .mb-3
                = f.label :title, t("shops.show.request_heading"), class: "form-label fw-medium"
                = f.text_field "job[title]", class: "form-control",
                    placeholder: t("shops.show.request_title_placeholder"), required: true
              .mb-3
                = f.label :description, t("common.fields.description"), class: "form-label fw-medium"
                = f.text_area "job[description]", class: "form-control", rows: 2,
                    placeholder: t("shops.show.request_description_placeholder")
              .row.g-2.mb-3
                .col-7
                  = f.label :desired_date, t("shops.show.request_desired_date"), class: "form-label fw-medium"
                  = f.date_field "job[desired_date]", class: "form-control", min: Date.current
                .col-5
                  = f.label :desired_hours, t("shops.show.request_est_hours"), class: "form-label fw-medium"
                  = f.number_field "job[desired_hours]", step: 0.5, min: 0.5, class: "form-control", placeholder: "8"
              = f.submit t("shops.show.request_submit"), class: "btn btn-primary w-100",
                  data: { disable_with: t("shops.show.request_sending") }
          - elsif signed_in?
            %p.text-muted.small.mb-3= t("shops.show.register_prompt")
            = link_to t("shops.show.register_link"), new_clients_registration_path, class: "btn btn-primary w-100"
          - else
            %p.text-muted.small.mb-3= t("shops.show.sign_in_prompt")
            = link_to t("shops.show.sign_in_link"), users_sign_in_path, class: "btn btn-primary w-100"
          %p.text-muted.small.mt-3.mb-0
            %i.bi.bi-shield-check.me-1
            = t("shops.show.payment_notice")

    - if @shop.active? && @shop.public_shop? && !current_user&.client? && !current_user&.shop_owner?
      .card.border-0.shadow-sm.mt-3
        .card-body
          %h6.fw-bold.mb-1
            %i.bi.bi-person-plus.me-1
            = t("shops.show.join_heading")
          %p.text-muted.small.mb-3= t("shops.show.join_body")
          = form_with url: shop_join_path(@shop.slug), method: :post, local: true do |f|
            .mb-2
              = text_field_tag :name, nil, class: "form-control form-control-sm",
                  placeholder: t("shops.show.join_name_placeholder"), required: true
            .mb-2
              = text_field_tag :email, nil, class: "form-control form-control-sm",
                  placeholder: t("shops.show.join_email_placeholder"), required: true, type: "email"
            = f.submit t("shops.show.join_submit"), class: "btn btn-outline-primary btn-sm w-100"

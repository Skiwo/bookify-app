= link_to t("onboarding.shops.new.back"), onboarding_path, class: "text-muted text-decoration-none small"
.row.justify-content-center.mt-2
  .col-lg-7
    .text-center.mb-4
      %i.bi.bi-shop.display-4.text-success
      %h3.fw-bold.mt-2= t("onboarding.shops.new.title")
      %p.text-muted= t("onboarding.shops.new.subtitle")

    .card.border-0.shadow-sm
      .card-body.p-4
        = form_with model: @shop, url: onboarding_shop_path, method: :post, local: true do |f|
          - if @shop.errors.any?
            .alert.alert-danger
              %ul.mb-0
                - @shop.errors.full_messages.each do |msg|
                  %li= msg

          .row
            .col-md-8.mb-3
              = f.label :name, t("onboarding.shops.new.name_label"), class: "form-label fw-medium"
              = f.text_field :name, class: "form-control form-control-lg",
                  placeholder: t("onboarding.shops.new.name_placeholder"), required: true,
                  data: { action: "input->slug-preview#update" }
            .col-md-4.mb-3
              = f.label :city, t("onboarding.shops.new.city_label"), class: "form-label fw-medium"
              = f.text_field :city, class: "form-control form-control-lg",
                  placeholder: t("onboarding.shops.new.city_placeholder")

          .mb-3
            = f.label :description, t("onboarding.shops.new.description_label"), class: "form-label fw-medium"
            = f.text_area :description, class: "form-control", rows: 3,
                placeholder: t("onboarding.shops.new.description_hint")

          .mb-3
            = f.label :skill_slugs, t("onboarding.shops.new.skills_label"), class: "form-label fw-medium"
            = f.select :skill_slugs,
                Skill.ordered.map { |s| [s.name, s.slug] },
                { selected: @shop.skill_slugs },
                multiple: true,
                data: { controller: "multi-select", "multi-select-placeholder-value": t("onboarding.shops.new.skills_placeholder") }
            %div.form-text= t("onboarding.shops.new.skills_hint")

          .row
            .col-md-6.mb-3
              = f.label :visibility, t("onboarding.shops.new.visibility_label"), class: "form-label fw-medium"
              = f.select :visibility,
                  [[t("onboarding.shops.new.visibility_public"), "public_shop"],
                   [t("onboarding.shops.new.visibility_private"), "private_shop"]],
                  {}, class: "form-select"
            .col-md-6.mb-3
              = f.label :commission_percent, t("onboarding.shops.new.commission_label"), class: "form-label fw-medium"
              .input-group
                = f.number_field :commission_percent, min: 0, max: 100, class: "form-control"
                %span.input-group-text %
              %div.form-text= t("onboarding.shops.new.commission_hint")

          .alert.alert-light.border.small
            %i.bi.bi-shield-check.text-success.me-1
            = t("onboarding.shops.new.payment_notice")
            %strong= t("common.payout_partner")
            = t("onboarding.shops.new.payment_notice_suffix")

          = f.submit t("onboarding.shops.new.submit"), class: "btn btn-success btn-lg w-100 mt-2",
              data: { disable_with: t("common.actions.saving") }

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin:0; padding:0; background:#f8f9fa; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; color:#212529; }
    .wrapper { max-width:480px; margin:0 auto; padding:40px 20px; }
    .card { background:#fff; border-radius:12px; padding:40px 32px; }
    .logo { font-size:22px; font-weight:700; color:#4f46e5; margin-bottom:28px; text-align:center; }
    .logo span { display:inline-block; width:32px; height:32px; background:#4f46e5; color:#fff; border-radius:8px; text-align:center; line-height:32px; font-size:18px; font-weight:700; margin-right:8px; vertical-align:middle; }
    h1 { font-size:20px; font-weight:700; margin:0 0 12px; text-align:center; }
    .body-text { color:#495057; font-size:15px; margin:0 0 24px; text-align:center; }
    .detail-box { background:#f8f9fa; border-radius:8px; padding:16px 20px; margin:0 0 24px; font-size:14px; color:#495057; }
    .detail-box strong { display:block; margin-bottom:4px; color:#212529; }
    .amount { font-size:22px; font-weight:700; color:#2563eb; text-align:center; margin:0 0 24px; }
    .btn-wrap { text-align:center; margin-bottom:24px; }
    .btn { display:inline-block; background:#4f46e5; color:#fff !important; text-decoration:none; padding:13px 32px; border-radius:8px; font-size:15px; font-weight:600; }
    .btn-amber { background:#d97706; }
    .btn-danger { background:#dc2626; }
    .btn-success { background:#059669; }
    .divider { border:none; border-top:1px solid #e9ecef; margin:24px 0; }
    .footer { text-align:center; margin-top:24px; color:#adb5bd; font-size:13px; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="card">
      <div class="logo"><span>B</span> Bookify</div>
      <h1><%= heading %></h1>
      <p class="body-text"><%= body_text %></p>
      <% if local_assigns[:amount_ore] %>
        <div class="amount"><%= number_to_currency(amount_ore / 100.0, unit: "kr ", separator: ",", delimiter: " ", format: "%u%n") %></div>
      <% end %>
      <% if local_assigns[:detail_label] %>
        <div class="detail-box">
          <strong><%= detail_label %></strong>
          <%= detail_value %>
        </div>
      <% end %>
      <% if local_assigns[:cta_url] %>
        <div class="btn-wrap">
          <a href="<%= cta_url %>" class="btn <%= local_assigns[:btn_class] %>"><%= cta_text %> &rarr;</a>
        </div>
      <% end %>
    </div>
    <div class="footer">
      <p>Bookify &mdash; <%= Date.current.year %></p>
    </div>
  </div>
</body>
</html>

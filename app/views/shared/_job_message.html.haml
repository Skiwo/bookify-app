- if message.system_message?
  .chat-system{"data-message-id": message.id}
    %span= message.body
    %span.chat-system-time= message.created_at.strftime("%H:%M")
- else
  - mine = local_assigns[:current_user_id].present? && message.sender_id.to_s == local_assigns[:current_user_id].to_s
  - first = local_assigns.fetch(:group_first, true)
  - sender_name = local_assigns[:job].present? ? chat_sender_name(message, local_assigns[:job]) : (message.sender.name.presence || message.sender.email)
  .chat-msg{"data-sender-id": message.sender_id, "data-message-id": message.id, "data-created-at": message.created_at.iso8601, class: [mine ? "mine" : "theirs", first ? nil : "grouped"].compact.join(" ")}
    - if first && !mine
      %span.chat-sender-name= sender_name
    .chat-bubble
      - if message.body.present?
        .chat-body= message.body
      - if message.file.attached?
        - blob_path = Rails.application.routes.url_helpers.rails_blob_path(message.file, only_path: true)
        .chat-attachment
          - if message.image_attachment?
            %img{src: blob_path, loading: "lazy"}
          - elsif message.audio_attachment?
            .voice-player{"data-controller": "audio-player"}
              %audio{"data-audio-player-target": "audio", preload: "metadata"}
                %source{src: blob_path, type: message.file.content_type}
              %button.voice-play-btn{type: "button", "data-action": "click->audio-player#togglePlay"}
                %i.bi.bi-play-fill{"data-audio-player-target": "playBtn"}
              .voice-track{"data-audio-player-target": "progress", "data-action": "click->audio-player#seek"}
                .voice-track-fill{"data-audio-player-target": "progressBar"}
              %span.voice-time{"data-audio-player-target": "time"} 0:00
          - elsif message.pdf_attachment?
            .d-flex.align-items-center.gap-2
              %i.bi.bi-file-earmark-pdf.fs-5
              %a{href: blob_path, target: "_blank", style: "color: inherit;"}= message.file.filename
      .chat-footer
        %span.chat-time= message.created_at.strftime("%H:%M")
        - if mine
          - if local_assigns[:other_participant_ids].present?
            - reads = local_assigns[:job_reads] || {}
            - read_count = local_assigns[:other_participant_ids].count { |uid| reads[uid]&.last_read_at && reads[uid].last_read_at >= message.created_at }
            - all_read = read_count == local_assigns[:other_participant_ids].size
          - else
            - all_read = false
          %span.chat-check{class: all_read ? "read" : nil}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M2 12l4 4 8-8" stroke="currentColor" stroke-width="2"/><path d="M8 12l4 4 8-8" stroke="currentColor" stroke-width="2"/></svg>

.card.border-0.shadow-sm
  .card-header.bg-white.fw-bold
    %i.bi.bi-chat.me-2
    Chat

  .card-body{"data-controller": "job-chat", "data-job-chat-job-id-value": job.id, style: "max-height: 400px; overflow-y: auto;"}
    #chat-messages
      - if messages.any?
        - messages.each do |message|
          = render "shared/job_message", message: message
      - else
        %p.text-muted.small.mb-0#chat-empty
          - if job.accepted? || job.in_progress? || job.pending_confirmation?
            Chat is open. Send a message to the other parties.
          - else
            Chat opens after the quote is accepted.

  - if signed_in? && (job.accepted? || job.in_progress? || job.pending_confirmation?)
    .card-footer.bg-white
      = form_with url: job_messages_path, method: :post,
          data: { controller: "chat-form", action: "turbo:submit-end->chat-form#reset" } do |f|
        = f.hidden_field :job_id, value: job.id
        .input-group
          = f.text_field "message[body]", class: "form-control", placeholder: "Type a message…",
              required: true, data: { "chat-form-target": "input" }
          = f.submit "Send", class: "btn btn-primary"

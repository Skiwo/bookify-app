:css
  .chat-window { display: flex; flex-direction: column; gap: 4px; padding: 8px 0; }
  .chat-msg { display: flex; flex-direction: column; max-width: 75%; }
  .chat-msg.mine { align-self: flex-end; }
  .chat-msg.theirs { align-self: flex-start; }
  .chat-bubble { padding: 8px 12px; border-radius: 16px; font-size: 0.875rem; line-height: 1.4; word-wrap: break-word; }
  .chat-msg.theirs .chat-bubble { background: #f0f0f0; color: #1a1a1a; border-bottom-left-radius: 4px; }
  .chat-msg.mine .chat-bubble { background: var(--brand, #2563EB); color: #fff; border-bottom-right-radius: 4px; }
  .chat-meta { display: flex; align-items: baseline; gap: 6px; margin-bottom: 2px; }
  .chat-sender { font-weight: 600; font-size: 0.75rem; }
  .chat-msg.theirs .chat-sender { color: #555; }
  .chat-msg.mine .chat-sender { color: rgba(255,255,255,0.8); }
  .chat-time { font-size: 0.675rem; }
  .chat-msg.theirs .chat-time { color: #999; }
  .chat-msg.mine .chat-time { color: rgba(255,255,255,0.6); }
  .chat-body { white-space: pre-wrap; }
  .chat-input-wrap { display: flex; gap: 8px; align-items: center; padding: 8px 16px; border-top: 1px solid #eee; }
  .chat-input-wrap .form-control { border-radius: 20px; border: 1px solid #ddd; }
  .chat-input-wrap .btn { border-radius: 50%; width: 40px; height: 40px; padding: 0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

.card.border-0.shadow-sm
  .card-header.bg-white.fw-bold
    %i.bi.bi-chat.me-2
    Chat

  .card-body{"data-controller": "job-chat", "data-job-chat-job-id-value": job.id, "data-job-chat-user-id-value": current_user&.id.to_s, style: "max-height: 420px; overflow-y: auto;"}
    .chat-window#chat-messages
      - if messages.any?
        - messages.each do |message|
          = render "shared/job_message", message: message, current_user_id: current_user&.id
      - else
        %p.text-muted.small.mb-0.text-center.py-3#chat-empty
          - if job.accepted? || job.in_progress? || job.pending_confirmation?
            Chat is open. Send a message to the other parties.
          - else
            Chat opens after the quote is accepted.

  - if signed_in? && (job.accepted? || job.in_progress? || job.pending_confirmation?)
    .chat-input-wrap
      = form_with url: job_messages_path, method: :post, class: "d-flex gap-2 w-100 align-items-center",
          data: { controller: "chat-form", action: "turbo:submit-end->chat-form#reset" } do |f|
        = f.hidden_field :job_id, value: job.id
        = f.text_field "message[body]", class: "form-control", placeholder: "Type a message…",
            required: true, autocomplete: "off", data: { "chat-form-target": "input" }
        = f.submit "", class: "btn btn-primary bi bi-send"

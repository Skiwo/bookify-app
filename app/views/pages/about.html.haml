- content_for :title, t("pages.about.title")
- content_for :description, t("pages.about.meta_description")

.row.justify-content-center.mt-4
  .col-md-8
    %h1.fw-bold= t("pages.about.heading")
    %p.lead.text-muted
      != t("pages.about.lead_html", link: link_to(t("pages.about.link_pop"), "https://payoutpartner.com", target: "_blank"))

    .card.border-0.shadow-sm.my-4
      .card-body.p-4
        %h4.fw-bold= t("pages.about.what_heading")
        %p= t("pages.about.what_p1")
        %p.mb-0= t("pages.about.what_p2")

    .card.border-0.shadow-sm.my-4
      .card-body.p-4
        %h4.fw-bold= t("pages.about.how_heading")
        .row.g-3.mt-2
          .col-md-6
            .d-flex.align-items-start
              %span.badge.rounded-pill.bg-primary.me-3.mt-1 1
              %div
                %strong= t("pages.about.step1_title")
                %p.text-muted.small.mb-0= t("pages.about.step1_text")
          .col-md-6
            .d-flex.align-items-start
              %span.badge.rounded-pill.bg-primary.me-3.mt-1 2
              %div
                %strong= t("pages.about.step2_title")
                %p.text-muted.small.mb-0= t("pages.about.step2_text")
          .col-md-6
            .d-flex.align-items-start
              %span.badge.rounded-pill.bg-primary.me-3.mt-1 3
              %div
                %strong= t("pages.about.step3_title")
                %p.text-muted.small.mb-0= t("pages.about.step3_text")
          .col-md-6
            .d-flex.align-items-start
              %span.badge.rounded-pill.bg-primary.me-3.mt-1 4
              %div
                %strong= t("pages.about.step4_title")
                %p.text-muted.small.mb-0= t("pages.about.step4_text")

    .card.border-0.shadow-sm.my-4
      .card-body.p-4
        %h4.fw-bold= t("pages.about.links_heading")
        %ul.list-unstyled.mb-0
          %li.mb-2
            %i.bi.bi-github.me-2
            %a{href: "https://github.com/skiwo/bookify-app", target: "_blank"}= t("pages.about.link_source")
          %li.mb-2
            %i.bi.bi-globe.me-2
            %a{href: "https://payoutpartner.com", target: "_blank"}= t("pages.about.link_pop")
          %li
            %i.bi.bi-file-code.me-2
            %a{href: "https://sandbox.core.payoutpartner.com/api-docs", target: "_blank"}= t("pages.about.link_api")

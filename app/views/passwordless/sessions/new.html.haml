.row.justify-content-center.mt-5
  .col-md-5.col-lg-4
    .card.shadow-sm.border-0
      .card-body.p-4
        .text-center.mb-4
          %i.bi.bi-book.display-6.text-primary
          %h3.fw-bold.mt-2= t("passwordless.new.title")
          %p.text-muted= t("passwordless.new.subtitle")

        = form_with model: @session, url: url_for(action: "new"), data: { turbo: "false" } do |f|
          .mb-3
            = label_tag "passwordless[#{email_field}]", t("passwordless.new.email_label"), class: "form-label", for: "passwordless_#{email_field}"
            = email_field_tag "passwordless[#{email_field}]", params.dig(:passwordless, email_field), class: "form-control form-control-lg", required: true, autofocus: true, placeholder: t("passwordless.new.email_placeholder"), id: "passwordless_#{email_field}"
          = f.submit t("passwordless.new.submit"), class: "btn btn-primary btn-lg w-100"

        %p.text-muted.small.text-center.mt-3.mb-0
          = t("passwordless.new.hint")

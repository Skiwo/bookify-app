.d-flex.justify-content-between.align-items-center.mb-4
  %h2 Jobs

  .d-flex.gap-2
    - %w[draft quoted accepted in_progress pending_confirmation invoiced completed].each do |s|
      = link_to s.humanize, shop_jobs_path(status: s),
          class: "btn btn-sm #{params[:status] == s ? 'btn-primary' : 'btn-outline-secondary'}"
    = link_to "All", shop_jobs_path, class: "btn btn-sm #{params[:status].blank? ? 'btn-primary' : 'btn-outline-secondary'}"

- if @jobs.any?
  .table-responsive
    %table.table.table-hover.align-middle
      %thead.table-light
        %tr
          %th Title
          %th Client
          %th Member
          %th Amount
          %th Status
          %th
      %tbody
        - @jobs.each do |job|
          %tr
            %td
              = link_to job.title, shop_job_path(job), class: "fw-medium text-decoration-none"
            %td.text-muted= job.client.org_name
            %td.text-muted= job.assigned_member&.name || "—"
            %td= job.work_amount_ore ? format_nok(job.work_amount_ore) : "—"
            %td
              %span.badge{class: job.draft? ? "bg-secondary" : job.invoiced? || job.paid? ? "bg-success" : job.disputed? ? "bg-danger" : "bg-primary"}
                = job.status.humanize
            %td.text-end
              = link_to "View", shop_job_path(job), class: "btn btn-sm btn-outline-primary"
- else
  .text-center.py-5
    %i.bi.bi-briefcase.display-3.text-muted
    %h5.fw-bold.mt-3 No jobs yet
    %p.text-muted Jobs appear here when clients submit requests.

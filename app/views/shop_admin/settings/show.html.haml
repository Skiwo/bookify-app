%h2.mb-4= t("shop_admin.settings.title")

.card.border-0.shadow-sm
  .card-body
    = form_with model: @shop, url: shop_settings_path, method: :patch, local: true, multipart: true do |f|
      .row
        .col-md-6.mb-3
          = f.label :name, t("shop_admin.settings.shop_name"), class: "form-label fw-medium"
          = f.text_field :name, class: "form-control", required: true

        .col-md-6.mb-3
          = f.label :city, t("shop_admin.settings.city"), class: "form-label fw-medium"
          = f.text_field :city, class: "form-control", placeholder: t("shop_admin.settings.city_placeholder")

      .mb-3
        = f.label :avatar, t("shop_admin.settings.logo"), class: "form-label fw-medium"
        .d-flex.align-items-center.gap-3
          - if @shop.avatar.attached?
            = image_tag @shop.avatar, class: "rounded-circle", style: "width:56px;height:56px;object-fit:cover"
          - else
            .rounded-circle.bg-light.d-flex.align-items-center.justify-content-center{style: "width:56px;height:56px;flex-shrink:0"}
              %i.bi.bi-shop.text-muted.fs-4
          = f.file_field :avatar, class: "form-control", accept: "image/*"

      .mb-3
        = f.label :description, t("shop_admin.settings.description"), class: "form-label fw-medium"
        = f.text_area :description, class: "form-control", rows: 4

      .mb-3
        = f.label :skill_slugs, t("shop_admin.settings.skills_label"), class: "form-label fw-medium"
        = f.select :skill_slugs,
            Skill.ordered.map { |s| [s.name, s.slug] },
            { selected: @shop.skill_slugs },
            multiple: true,
            data: { controller: "multi-select", "multi-select-placeholder-value": t("shop_admin.settings.skills_placeholder") }

      .row
        .col-md-6.mb-3
          = f.label :visibility, t("shop_admin.settings.hiring_policy"), class: "form-label fw-medium"
          = f.select :visibility,
              [[t("shop_admin.settings.hiring_open"), "public_shop"],
               [t("shop_admin.settings.hiring_closed"), "private_shop"]],
              {}, class: "form-select"
          %p.form-text.text-muted= t("shop_admin.settings.hiring_hint")

        .col-md-6.mb-3
          = f.label :commission_percent, t("shop_admin.settings.commission"), class: "form-label fw-medium"
          .input-group
            = f.number_field :commission_percent, min: 0, max: 50, class: "form-control"
            %span.input-group-text %
          %p.form-text.text-muted= t("shop_admin.settings.commission_hint")

      .mb-4.border-top.pt-4
        %h6.fw-bold.text-muted= t("shop_admin.settings.pop_section")
        .mb-3
          = f.label :pop_worker_id, t("shop_admin.settings.pop_worker_id"), class: "form-label fw-medium"
          - if @shop.pop_worker_id.present?
            = f.text_field :pop_worker_id, class: "form-control font-monospace", disabled: true
            %div.form-text.text-success
              %i.bi.bi-check-circle.me-1
              = t("shop_admin.settings.pop_enrolled")
          - else
            .input-group
              = f.text_field :pop_worker_id, class: "form-control font-monospace", disabled: true
              = link_to bookify_onboarding_shop_path, class: "btn btn-outline-secondary" do
                %i.bi.bi-box-arrow-up-right.me-1
                = t("shop_admin.settings.pop_connect")
            %div.form-text.text-warning
              %i.bi.bi-exclamation-triangle.me-1
              = t("shop_admin.settings.pop_not_enrolled")

      = f.submit t("shop_admin.settings.save"), class: "btn btn-primary"

  .card-footer.bg-white
    %h6.fw-bold.mb-3= t("shop_admin.settings.status_heading")
    .d-flex.align-items-center.gap-3.flex-wrap
      %span
        = t("shop_admin.settings.current_status")
        %span.badge.ms-1{class: @shop.active? ? "bg-success" : @shop.paused? ? "bg-warning text-dark" : @shop.closed? ? "bg-secondary" : "bg-light text-dark"}
          = t("common.status.#{@shop.status}", default: @shop.status.humanize)
      - if @shop.active?
        = button_to t("shop_admin.settings.pause"), pause_shop_settings_path, method: :post,
            class: "btn btn-sm btn-outline-warning",
            data: { turbo_confirm: t("shop_admin.settings.pause_confirm") }
        = button_to t("shop_admin.settings.close"), close_shop_settings_path, method: :post,
            class: "btn btn-sm btn-outline-danger",
            data: { turbo_confirm: t("shop_admin.settings.close_active_confirm") }
      - elsif @shop.paused?
        = button_to t("shop_admin.settings.reopen"), reopen_shop_settings_path, method: :post, class: "btn btn-sm btn-success"
        = button_to t("shop_admin.settings.close"), close_shop_settings_path, method: :post,
            class: "btn btn-sm btn-outline-danger",
            data: { turbo_confirm: t("shop_admin.settings.close_paused_confirm") }
      - elsif @shop.closed?
        = button_to t("shop_admin.settings.reopen"), reopen_shop_settings_path, method: :post, class: "btn btn-sm btn-success"
      - elsif @shop.draft?
        = button_to t("shop_admin.settings.publish"), reopen_shop_settings_path, method: :post, class: "btn btn-sm btn-success"

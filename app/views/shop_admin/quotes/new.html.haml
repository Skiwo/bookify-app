= link_to "← Back to job", shop_job_path(@job), class: "text-muted text-decoration-none small"
%h2.fw-bold.mt-1.mb-4 Issue quote

.row
  .col-lg-6
    .card.border-0.shadow-sm.mb-4
      .card-header.bg-white.fw-bold Job
      .card-body
        %p.fw-medium.mb-1= @job.title
        %p.text-muted.small.mb-0= @job.client.org_name
        - if @job.description.present?
          %p.text-muted.small.mt-2.mb-0= @job.description

  .col-lg-6
    .card.border-0.shadow-sm
      .card-header.bg-white.fw-bold Quote details
      .card-body
        = form_with url: shop_quotes_path, method: :post, local: true do |f|
          = f.hidden_field :job_id, value: @job.id

          .row.g-2.mb-3
            .col-7
              = f.label :rate_per_hour_nok, "Hourly rate (NOK)", class: "form-label fw-medium"
              .input-group
                %span.input-group-text kr
                = f.number_field :rate_per_hour_nok, step: 1, min: 1, class: "form-control",
                    placeholder: "e.g. 500", required: true
            .col-5
              = f.label :estimated_hours, "Est. hours", class: "form-label fw-medium"
              = f.number_field :estimated_hours, step: 0.5, min: 0.5, class: "form-control",
                  placeholder: "e.g. 8", required: true

          .alert.alert-light.border.small.mb-3
            %i.bi.bi-calculator.me-1
            Total = rate × hours.
            %strong#quote-total —
            Client can adjust hours on confirmation.

          .mb-3
            = f.label :assigned_member_id, "Assign member", class: "form-label fw-medium"
            = f.select :assigned_member_id,
                @members.map { |m| [m.name, m.id] },
                { include_blank: "— Select member —" },
                class: "form-select"

          .alert.alert-info.small
            %i.bi.bi-info-circle.me-1
            Commission of #{current_shop.commission_percent}% added automatically. Net-14 invoice from Payout Partner AS.

          = f.submit "Send quote (72h window)", class: "btn btn-primary w-100"

:javascript
  const rate = document.querySelector('[name="rate_per_hour_nok"]')
  const hours = document.querySelector('[name="estimated_hours"]')
  const total = document.querySelector('#quote-total')
  function updateTotal() {
    const r = parseFloat(rate.value) || 0
    const h = parseFloat(hours.value) || 0
    const t = r * h
    total.textContent = t > 0 ? 'kr ' + t.toLocaleString('nb-NO', {minimumFractionDigits: 0}) : '—'
  }
  rate.addEventListener('input', updateTotal)
  hours.addEventListener('input', updateTotal)
  updateTotal()

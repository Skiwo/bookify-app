= link_to "← Back to job", shop_job_path(@job), class: "text-muted text-decoration-none small"
%h2.fw-bold.mt-1.mb-4 Issue quote

.row
  .col-lg-6
    .card.border-0.shadow-sm.mb-4
      .card-header.bg-white.fw-bold Job
      .card-body
        %p.fw-medium.mb-1= @job.title
        %p.text-muted.small.mb-0= @job.client.org_name
        - if @job.description.present?
          %p.text-muted.small.mt-2.mb-0= @job.description

  .col-lg-6
    .card.border-0.shadow-sm
      .card-header.bg-white.fw-bold Quote details
      .card-body
        = form_with url: shop_quotes_path, method: :post, local: true do |f|
          = f.hidden_field :job_id, value: @job.id

          .mb-3{"data-controller": "quote-lines"}
            %label.form-label.fw-medium Activities
            .quote-lines-list{"data-quote-lines-target": "container"}
              .quote-line.row.g-2.mb-2
                .col-5
                  %input.form-control.form-control-sm{type: "text", name: "quote_lines[][description]", placeholder: "Activity", required: true}
                .col-3
                  %input.form-control.form-control-sm{type: "number", name: "quote_lines[][rate_nok]", placeholder: "kr/h", min: 1, step: 1, required: true, "data-field": "rate", "data-action": "input->quote-lines#calculate"}
                .col-2
                  %input.form-control.form-control-sm{type: "number", name: "quote_lines[][hours]", placeholder: "h", min: 0.5, step: 0.5, required: true, "data-field": "hours", "data-action": "input->quote-lines#calculate"}
                .col-1.d-flex.align-items-center
                  %span.small.text-muted{"data-field": "amount"} —
                .col-1.d-flex.align-items-center
                  %button.btn-close{type: "button", style: "font-size: 0.5rem;", "data-action": "click->quote-lines#remove"}

            %template{"data-quote-lines-target": "template"}
              .quote-line.row.g-2.mb-2
                .col-5
                  %input.form-control.form-control-sm{type: "text", name: "quote_lines[][description]", placeholder: "Activity", required: true}
                .col-3
                  %input.form-control.form-control-sm{type: "number", name: "quote_lines[][rate_nok]", placeholder: "kr/h", min: 1, step: 1, required: true, "data-field": "rate", "data-action": "input->quote-lines#calculate"}
                .col-2
                  %input.form-control.form-control-sm{type: "number", name: "quote_lines[][hours]", placeholder: "h", min: 0.5, step: 0.5, required: true, "data-field": "hours", "data-action": "input->quote-lines#calculate"}
                .col-1.d-flex.align-items-center
                  %span.small.text-muted{"data-field": "amount"} —
                .col-1.d-flex.align-items-center
                  %button.btn-close{type: "button", style: "font-size: 0.5rem;", "data-action": "click->quote-lines#remove"}

            .d-flex.justify-content-between.align-items-center.mt-2
              %button.btn.btn-outline-secondary.btn-sm{type: "button", "data-action": "click->quote-lines#add"}
                %i.bi.bi-plus.me-1
                Add activity
              .fw-bold
                Total:
                %span{"data-quote-lines-target": "total"} —

          .mb-3
            = f.label :assigned_member_id, "Assign member", class: "form-label fw-medium"
            - if @members.any?
              = f.select :assigned_member_id,
                  @members.map { |m| [m.bookify_pop_worker_id.present? ? m.name : "#{m.name} (not enrolled)", m.id, m.bookify_pop_worker_id.blank? ? { disabled: true } : {}] },
                  { include_blank: "— Select member —" },
                  class: "form-select"
              - if @members.any? { |m| m.bookify_pop_worker_id.blank? }
                %p.form-text.text-warning
                  %i.bi.bi-shield-exclamation.me-1
                  Greyed-out members haven't completed POP onboarding (BankID) yet.
            - else
              .alert.alert-warning.small.mb-0
                %i.bi.bi-people.me-2
                No enrolled members yet.
                = link_to "Add a member →", shop_members_path, class: "alert-link"

          .alert.alert-info.small
            %i.bi.bi-info-circle.me-1
            Commission of #{current_shop.commission_percent}% added automatically.
            - if @job.bookify_fee?
              = " Bookify platform fee kr #{Job::BOOKIFY_FEE_ORE / 100} applies to this client."
            Net-14 invoice from Payout Partner AS.

          = f.submit "Send quote (72h window)", class: "btn btn-primary w-100", data: { disable_with: "Sending…" }

= link_to "← Members", shop_members_path, class: "text-muted text-decoration-none small"
%h2.fw-bold.mt-1.mb-4 Add roster member

.card.border-0.shadow-sm
  .card-body
    = form_with url: shop_members_path, method: :post, local: true do |f|
      .mb-3
        %label.form-label.fw-medium Select enrolled freelancer
        = select_tag "shop_member[enrollment_id]",
            options_from_collection_for_select(current_user.enrollments_as_booker.active, :id, :name),
            class: "form-select",
            include_blank: "— Choose freelancer —",
            required: true
        %div.form-text Only active POP enrollments are listed.

      = f.submit "Add to roster", class: "btn btn-primary"

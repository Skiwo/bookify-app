= link_to t("shop_admin.members.new.back"), shop_members_path, class: "text-muted text-decoration-none small"
%h2.fw-bold.mt-1.mb-4= t("shop_admin.members.new.title")

.row.justify-content-center
  .col-md-6
    .card.border-0.shadow-sm
      .card-body
        %p.text-muted.small.mb-3= t("shop_admin.members.new.subtitle")
        = form_with url: invite_shop_members_path, method: :post, local: true do |f|
          .mb-3
            %label.form-label.fw-medium= t("shop_admin.members.new.email_label")
            = text_field_tag :email, nil, class: "form-control",
                placeholder: t("shop_admin.members.new.email_placeholder"),
                required: true, type: "email"
          .mb-3
            %label.form-label.fw-medium= t("shop_admin.members.new.name_label")
            = text_field_tag :name, nil, class: "form-control",
                placeholder: t("shop_admin.members.new.name_placeholder")
          = f.submit t("shop_admin.members.new.submit"), class: "btn btn-primary w-100",
              data: { disable_with: t("common.actions.sending") }

%h2.mb-4
  = @shop.name
  %span.badge.ms-2{class: @shop.active? ? "bg-success" : "bg-secondary"}
    = t("common.status.#{@shop.status}", default: @shop.status.humanize)

- stat_col = current_shop.solo? ? "col-md-6" : "col-md-4"
.row.mb-4
  .mb-3{class: stat_col}
    .card.border-0.shadow-sm.sidebar-tint
      .card-body.text-center.py-3
        %h3.text-primary.fw-bold.mb-0= @pending_jobs.size
        %p.text-muted.small.mb-0= t("shop_admin.dashboard.show.new_requests")
  .mb-3{class: stat_col}
    .card.border-0.shadow-sm.sidebar-tint
      .card-body.text-center.py-3
        %h3.text-primary.fw-bold.mb-0= @active_jobs.size
        %p.text-muted.small.mb-0= t("shop_admin.dashboard.show.active_jobs")
  - unless current_shop.solo?
    .col-md-4.mb-3
      .card.border-0.shadow-sm.sidebar-tint
        .card-body.text-center.py-3
          %h3.text-primary.fw-bold.mb-0= @members_count
          %p.text-muted.small.mb-0= t("shop_admin.dashboard.show.active_members")

.row
  .col-md-6
    .card.border-0.shadow-sm
      .card-header.bg-white.fw-bold= t("shop_admin.dashboard.show.new_requests")
      .card-body
        - if @pending_jobs.any?
          .list-group.list-group-flush
            - @pending_jobs.each do |job|
              = link_to shop_job_path(job), class: "list-group-item list-group-item-action" do
                .d-flex.justify-content-between
                  %span.fw-medium= job.title
                  %small.text-muted= time_ago_in_words(job.created_at) + " ago"
                %small.text-muted= job.client.org_name
        - else
          %p.text-muted.mb-0.py-2= t("shop_admin.dashboard.show.no_new_requests")

  .col-md-6
    .card.border-0.shadow-sm
      .card-header.bg-white.fw-bold= t("shop_admin.dashboard.show.active_jobs")
      .card-body
        - if @active_jobs.any?
          .list-group.list-group-flush
            - @active_jobs.each do |job|
              = link_to shop_job_path(job), class: "list-group-item list-group-item-action" do
                .d-flex.justify-content-between
                  %span.fw-medium= job.title
                  %span.badge.bg-primary.rounded-pill
                    = t("common.status.#{job.status}", default: job.status.humanize)
        - else
          %p.text-muted.mb-0.py-2= t("shop_admin.dashboard.show.no_active_jobs")

= link_to "← Dashboard", freelancer_dashboard_path, class: "text-muted text-decoration-none small"
.d-flex.align-items-start.mt-1.mb-4
  .me-auto
    %h2.fw-bold.mb-1= @job.title
    %p.text-muted.mb-0= @job.shop.name
  - if @job.in_progress? || @job.accepted?
    = form_with url: mark_complete_freelancer_job_path(@job), method: :post, local: true, class: "d-flex gap-2 align-items-end" do |f|
      .d-flex.flex-column
        %label.form-label.small.mb-1.text-muted Work date
        = f.date_field :work_date, value: @job.work_date || Date.current, max: Date.current, class: "form-control form-control-sm"
      .d-flex.flex-column
        %label.form-label.small.mb-1.text-muted Hours
        = f.number_field :work_hours, value: @job.work_hours || 8, step: 0.5, min: 0.5, max: 24, class: "form-control form-control-sm", style: "width:80px"
      = f.submit "Mark complete", class: "btn btn-success btn-sm"

.row
  .col-lg-7
    = render "shared/job_chat", job: @job, messages: @messages

  .col-lg-5
    .card.border-0.shadow-sm.mb-4
      .card-header.bg-white.fw-bold Job details
      .card-body
        %dl.row.mb-0
          %dt.col-sm-5 Status
          %dd.col-sm-7
            %span.badge{class: @job.invoiced? || @job.paid? ? "bg-success" : @job.disputed? ? "bg-danger" : "bg-primary"}
              = @job.status.humanize
          %dt.col-sm-5 Shop
          %dd.col-sm-7= @job.shop.name
          %dt.col-sm-5 Client
          %dd.col-sm-7= @job.client.org_name
          - if @job.work_amount_ore
            %dt.col-sm-5 Your earnings
            %dd.col-sm-7
              %span.fw-bold= format_nok(@job.work_amount_ore)
              %div.text-muted.small before tax & POP fees
          - if @job.description.present?
            %dt.col-sm-5 Description
            %dd.col-sm-7= @job.description

    .card.border-0.shadow-sm
      .card-header.bg-white.fw-bold What happens next
      .card-body.small
        - case @job.status.to_sym
        - when :accepted, :in_progress
          %p.mb-0 Work is underway. Chat with the shop or client if you have questions.
        - when :pending_confirmation
          %p.mb-0 The shop has marked this job complete. Waiting for client confirmation.
        - when :invoiced
          - payout = @job.booking&.payout
          %p.mb-2 Invoice issued. You'll be paid on the next Thursday batch.
          - if payout
            - if payout.pop_invoice_number.present?
              %p.mb-1.small Invoice ##{payout.pop_invoice_number} · #{payout.pop_status}
            - else
              %p.mb-1.small.text-warning #{payout.pop_status} — invoice number pending
            = button_to "↻ Refresh status", sync_payout_freelancer_job_path(@job), method: :post,
                class: "btn btn-outline-secondary btn-sm mb-2"
          %p.mb-0.text-muted Payout Partner AS handles tax withholding and A-melding.
        - when :paid, :completed
          %p.mb-0.text-success
            %i.bi.bi-check-circle.me-1
            Paid. Check your bank account and payslip from Payout Partner AS.
        - else
          %p.mb-0 Waiting for the shop to assign a quote.

= link_to "← Jobs", clients_jobs_path, class: "text-muted text-decoration-none small"
.d-flex.align-items-start.mt-1.mb-4
  .me-auto
    %h2.fw-bold.mb-1= @job.title
    %p.text-muted.mb-0= @job.shop.name
  - if @job.draft? || @job.quoted?
    = button_to "Cancel request", cancel_clients_job_path(@job), method: :post,
        class: "btn btn-outline-danger btn-sm",
        data: { turbo_confirm: "Cancel this request? The shop will be notified." }

.row
  .col-lg-7
    = render "shared/job_chat", job: @job, messages: @messages, older_count: @older_count, last_read_at: @last_read_at, job_reads: @job_reads, other_participant_ids: @other_participant_ids

  .col-lg-5
    - if @job.quoted?
      .card.border-0.shadow-sm.border-primary.mb-4
        .card-body
          %h6.fw-bold
            %i.bi.bi-file-earmark-text.me-1
            Quote received
          - if @job.quote_lines.any?
            %table.table.table-sm.small.mb-2
              %thead
                %tr
                  %th Activity
                  %th.text-end Rate
                  %th.text-end Hours
                  %th.text-end Amount
              %tbody
                - @job.quote_lines.order(:position).each do |ql|
                  %tr
                    %td= ql.description
                    %td.text-end= format_nok(ql.rate_ore)
                    %td.text-end= "#{ql.hours}h"
                    %td.text-end= format_nok(ql.amount_ore)
          %dl.row.mb-2
            %dt.col-sm-5 Work amount (excl. MVA)
            %dd.col-sm-7.fw-bold= format_nok(@job.work_amount_ore)
            %dt.col-sm-5 Commission (#{@job.shop.commission_percent}%)
            %dd.col-sm-7= format_nok(@job.commission_amount_ore)
            - if @job.bookify_fee?
              %dt.col-sm-5 Bookify platform fee
              %dd.col-sm-7= format_nok(@job.bookify_fee_ore)
            %dt.col-sm-5 MVA (25%)
            %dd.col-sm-7= format_nok((@job.total_amount_ore * 0.25).round)
            %dt.col-sm-5.fw-bold Total incl. MVA
            %dd.col-sm-7
              %strong.fs-5= format_nok((@job.total_amount_ore * 1.25).round)
          - if @job.quote_expires_at
            %p.small.text-muted.mb-3
              %i.bi.bi-clock.me-1
              Expires #{@job.quote_expires_at.strftime("%d %b %Y %H:%M")}
          - unless @job.quote_expired?
            .d-flex.gap-3
              = button_to "Accept quote", accept_clients_quote_path(@job), method: :post, class: "btn btn-success"
              = button_to "Decline", decline_clients_quote_path(@job), method: :post, class: "btn btn-outline-danger"
          - else
            .alert.alert-secondary.mb-0 This quote has expired.
    - if @job.pending_confirmation?
      .card.border-0.shadow-sm.border-warning.mb-4
        .card-body
          %h6.fw-bold
            %i.bi.bi-exclamation-triangle.me-1
            Job marked complete
          %p.small.mb-3 Please review the hours and confirm or raise a dispute.
          - if @job.confirmation_deadline_at
            %p.small.text-muted.mb-2
              %i.bi.bi-clock.me-1
              Deadline: #{@job.confirmation_deadline_at.strftime("%d %b %Y %H:%M")}
          = form_with url: mark_complete_clients_job_path(@job), method: :post, local: true do |f|
            .row.g-2.mb-3
              .col-6
                %label.form-label.small.fw-medium Work date
                = f.date_field :work_date, value: @job.work_date || Date.current, max: Date.current, class: "form-control form-control-sm"
              .col-6
                %label.form-label.small.fw-medium Hours worked
                = f.number_field :work_hours, value: @job.work_hours || 8, step: 0.5, min: 0.5, max: 24, class: "form-control form-control-sm"
            = f.submit "Confirm completion", class: "btn btn-success w-100 mb-2"
          %hr.my-2
          = form_with url: dispute_clients_job_path(@job), method: :post, local: true do |f|
            .mb-2
              = f.text_area "dispute[reason]", class: "form-control form-control-sm", rows: 2,
                  placeholder: "Describe the issue…", required: true
            = f.submit "Raise dispute", class: "btn btn-outline-danger btn-sm w-100"

    - if @job.disputed? && @job.dispute.present?
      .card.border-0.shadow-sm.border-danger.mb-4
        .card-body
          %h6.fw-bold.text-danger
            %i.bi.bi-exclamation-triangle.me-1
            Dispute
          %p.small.mb-1
            %strong Your reason:
          %p.small.mb-3= @job.dispute.reason
          - if @job.dispute.response.present?
            .alert.alert-info.small.mb-2
              %strong Shop response:
              %p.mb-0= @job.dispute.response
          - if @job.dispute.resolved? || @job.dispute.closed?
            .alert.alert-success.small.mb-0
              %i.bi.bi-check-circle.me-1
              Resolved: #{@job.dispute.resolution}
          - elsif @job.dispute.responded?
            %p.small.text-muted Waiting for resolution.
          - else
            %p.small.text-muted Waiting for shop response.

    .card.border-0.shadow-sm.mb-4
      .card-header.bg-white.fw-bold Job details
      .card-body
        %dl.row.mb-0
          %dt.col-sm-4 Status
          %dd.col-sm-8
            - badge = @job.cancelled? || @job.disputed? ? "bg-danger" : @job.invoiced? || @job.completed? ? "bg-success" : @job.draft? ? "bg-secondary" : "bg-primary"
            %span.badge{class: badge}= @job.status.humanize
          - if @job.work_amount_ore
            %dt.col-sm-4 Amount (excl. MVA)
            %dd.col-sm-8= format_nok(@job.work_amount_ore)
          %dt.col-sm-4 Shop
          %dd.col-sm-8= @job.shop.name
          %dt.col-sm-4 Member
          %dd.col-sm-8= @job.assigned_member&.name || "—"

    .card.border-0.shadow-sm
      .card-header.bg-white.fw-bold What happens next
      .card-body.small
        - case @job.status.to_sym
        - when :quoted
          %p.fw-medium Review the quote and accept or decline.
          %ol.ps-3.mb-0.small
            %li.mb-1 Accept the quote to start the job.
            %li.mb-1 Chat with the shop and assigned freelancer.
            %li.mb-1 Both sides mark the job as complete.
            %li You receive a Net-14 invoice from Payout Partner AS.
        - when :accepted, :in_progress
          %p Work is underway. Chat with the shop and assigned freelancer.
        - when :pending_confirmation
          %p.fw-medium Work has been marked complete — please confirm or raise a dispute above.
        - when :invoiced, :paid, :completed
          %p.mb-2 Invoice issued by Payout Partner AS. Net 14 days payment.
          %p.mb-3.text-muted You will receive the invoice by email.
          = link_to shop_path(@job.shop.slug), class: "btn btn-primary w-100" do
            %i.bi.bi-arrow-repeat.me-1
            Book again
        - when :disputed
          - if @job.dispute&.resolved? || @job.dispute&.closed?
            %p.text-success Dispute resolved. You can continue working with the shop.
          - elsif @job.dispute&.responded?
            %p.text-warning The shop has responded. Awaiting resolution.
          - else
            %p.text-danger Dispute raised. Waiting for shop response.
        - when :cancelled
          %p.text-muted This request was cancelled.
        - else
          %p Waiting for the shop to send a quote.

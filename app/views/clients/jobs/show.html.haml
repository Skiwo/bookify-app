= link_to "← Jobs", clients_jobs_path, class: "text-muted text-decoration-none small"
%h2.fw-bold.mt-1.mb-1= @job.title
%p.text-muted.mb-4= @job.shop.name

.row
  .col-lg-7
    - if @job.quoted?
      .card.border-0.shadow-sm.border-primary.mb-4
        .card-body
          %h6.fw-bold
            %i.bi.bi-file-earmark-text.me-1
            Quote received
          %dl.row.mb-2
            %dt.col-sm-5 Work amount (excl. MVA)
            %dd.col-sm-7.fw-bold= format_nok(@job.work_amount_ore)
            %dt.col-sm-5 Commission (#{@job.shop.commission_percent}%)
            %dd.col-sm-7= format_nok(@job.commission_amount_ore)
            %dt.col-sm-5 MVA (25%)
            %dd.col-sm-7= format_nok((@job.total_amount_ore * 0.25).round)
            %dt.col-sm-5.fw-bold Total incl. MVA
            %dd.col-sm-7
              %strong.fs-5= format_nok((@job.total_amount_ore * 1.25).round)
          - if @job.quote_expires_at
            %p.small.text-muted.mb-3
              %i.bi.bi-clock.me-1
              Expires #{@job.quote_expires_at.strftime("%d %b %Y %H:%M")}
          - unless @job.quote_expired?
            .d-flex.gap-3
              = button_to "Accept quote", accept_clients_quote_path(@job), method: :post, class: "btn btn-success"
              = button_to "Decline", decline_clients_quote_path(@job), method: :post, class: "btn btn-outline-danger"
          - else
            .alert.alert-secondary.mb-0 This quote has expired.

    = render "shared/job_chat", job: @job, messages: @messages, last_read_at: @last_read_at, job_reads: @job_reads, other_participant_ids: @other_participant_ids

  .col-lg-5
    - if (@job.in_progress? || @job.accepted?) && (@job.shop_completed? || @job.client_completed?)
      .card.border-0.shadow-sm.mb-4
        .card-body
          %h6.fw-bold
            %i.bi.bi-check2-circle.me-1
            Completion status
          .d-flex.gap-4.mt-2
            .d-flex.align-items-center.gap-2
              - if @job.shop_completed?
                %i.bi.bi-check-circle-fill.text-success
              - else
                %i.bi.bi-circle.text-muted
              %span.small Shop
            .d-flex.align-items-center.gap-2
              - if @job.client_completed?
                %i.bi.bi-check-circle-fill.text-success
              - else
                %i.bi.bi-circle.text-muted
              %span.small Client
          - if !@job.client_completed?
            .mt-3
              = button_to "Mark complete", mark_complete_clients_job_path(@job), method: :post, class: "btn btn-success w-100"

    - if (@job.in_progress? || @job.accepted?) && !@job.client_completed? && !@job.shop_completed? && @job.assigned_member.present?
      .card.border-0.shadow-sm.mb-4
        .card-body
          = button_to "Mark complete", mark_complete_clients_job_path(@job), method: :post, class: "btn btn-success w-100"

    .card.border-0.shadow-sm.mb-4
      .card-header.bg-white.fw-bold Job details
      .card-body
        %dl.row.mb-0
          %dt.col-sm-4 Status
          %dd.col-sm-8
            %span.badge{class: @job.disputed? ? "bg-danger" : @job.invoiced? || @job.completed? ? "bg-success" : "bg-primary"}
              = @job.status.humanize
          - if @job.work_amount_ore
            %dt.col-sm-4 Amount (excl. MVA)
            %dd.col-sm-8= format_nok(@job.work_amount_ore)
          %dt.col-sm-4 Shop
          %dd.col-sm-8= @job.shop.name
          %dt.col-sm-4 Member
          %dd.col-sm-8= @job.assigned_member&.name || "—"

    .card.border-0.shadow-sm
      .card-header.bg-white.fw-bold What happens next
      .card-body.small
        - case @job.status.to_sym
        - when :quoted
          %p.fw-medium Review the quote and accept or decline.
          %ol.ps-3.mb-0.small
            %li.mb-1 Accept the quote to start the job.
            %li.mb-1 Chat with the shop and assigned freelancer.
            %li.mb-1 Both sides mark the job as complete.
            %li You receive a Net-14 invoice from Payout Partner AS.
        - when :accepted, :in_progress
          - if @job.both_completed?
            %p.text-success Both sides confirmed. Invoice is being issued.
          - elsif @job.shop_completed?
            %p.fw-medium Shop has marked the job as complete. Please confirm when ready.
          - elsif @job.client_completed?
            %p Waiting for shop to confirm completion.
          - else
            %p Work is underway. When done, both sides mark the job as complete.
        - when :invoiced
          %p.mb-2 Invoice issued by Payout Partner AS. Net 14 days payment.
          %p.mb-0.text-muted You will receive the invoice by email.
        - when :disputed
          %p.text-danger A dispute has been raised. We will be in touch.
        - else
          %p Waiting for the shop to send a quote.
